    },
    {
      "key": "validation",
      "label": "input validation",
      "keywords": ["validation", "validate", "sanitize", "escape", "input"],
      "controls": ["validat", "sanitiz", "escape", "zod", "joi", "yup", "class-validator", "schema"],
      "severity": "high"
    },
    {
      "key": "injection",
      "label": "injection prevention",
      "keywords": ["injection", "sql", "query", "parameterized"],
      "controls": ["parameterized", "prepared", "placeholder", "prisma", "knex", "drizzle", "query builder", "escape"],
      "severity": "critical"
    },
    {
      "key": "secrets",
      "label": "secret handling",
      "keywords": ["secret", "token", "credential", "password"],
      "controls": ["process.env", "config.", "vault", "secret manager", "env["],
      "severity": "high"
    },
    {
      "key": "rate-limit",
      "label": "rate limiting",
      "keywords": ["rate limit", "throttle", "abuse", "brute force"],
      "controls": ["rate limit", "throttl", "limiter", "slowdown"],
      "severity": "medium"
    }
  ]
