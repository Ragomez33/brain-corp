{
  "name": "brain-corp",
  "version": "1.0.0",
  "description": "CLI de orquestación de ecosistemas multi-repositorio: topología de sidecars, tickets y sincronización con GitHub Issues.",
  "license": "MIT",
  "author": "Ragomez33",
  "homepage": "https://github.com/Ragomez33/brain-corp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ragomez33/brain-corp.git"
  },
  "bugs": {
    "url": "https://github.com/Ragomez33/brain-corp/issues"
  },
  "keywords": [
    "cli",
    "orchestration",
    "multi-repo",
    "monorepo",
    "tickets",
    "github-issues",
    "spec-kit",
    "agents"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "brain": "./bin/brain.js"
  },
  "files": [
    "bin/",
    "scripts/",
    "config/",
    ".agents/prompts/",
    ".agents/skills/",
    ".opencode/commands/",
    ".specify/",
    "README.md",
    "constitution.md",
    "LICENSE"
  ],
  "scripts": {
    "brain": "node bin/brain.js",
    "setup": "node scripts/setup-wizard.js",
    "init-brain": "node scripts/init-brain.js",
    "agents:sync": "node scripts/sync-agents.js",
    "sync": "node scripts/sync-github.js",
    "sanity": "node scripts/sanity-check.js",
    "sync:pull": "node scripts/sync-pull.js",
    "watch": "node scripts/watch-github.js",
    "normalize": "node scripts/normalize-ticket.js",
    "complete": "node scripts/complete-ticket.js",
    "hotfix": "node scripts/hotfix.js"
  },
  "dependencies": {
    "gray-matter": "^4.0.3"
  }
}
