{
  "name": "@rgkoko/brain-corp",
  "version": "1.1.1",
  "description": "CLI de orquestación de ecosistemas multi-repositorio: topología de sidecars, tickets y sincronización con GitHub Issues.",
  "license": "MIT",
  "author": "Ragomez33",
  "homepage": "https://github.com/Ragomez33/brain-corp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ragomez33/brain-corp.git"
  },
  "bugs": {
    "url": "https://github.com/Ragomez33/brain-corp/issues"
  },
  "keywords": [
    "cli",
    "orchestration",
    "multi-repo",
    "monorepo",
    "tickets",
    "github-issues",
    "spec-driven-development",
    "ears",
    "agents"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "brain": "bin/brain.js"
  },
  "files": [
    "bin",
    "scripts",
    "dist",
    "config",
    "templates",
    "LICENSE",
    "README.md",
    "constitution.md"
  ],
  "scripts": {
    "brain": "node bin/brain.js",
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "audit": "node scripts/audit.js",
    "setup": "node scripts/setup-wizard.js",
    "init-brain": "node scripts/init-brain.js",
    "agents:sync": "node scripts/sync-agents.js",
    "reset": "node scripts/reset.js",
    "sdd": "node scripts/sdd.js",
    "init-work": "node scripts/sdd.js init-work",
    "specify": "node scripts/sdd.js specify",
    "plan": "node scripts/sdd.js plan",
    "tasks": "node scripts/sdd.js tasks",
    "implement": "node scripts/sdd.js implement",
    "analyze": "node scripts/sdd.js analyze",
    "sync": "node scripts/sync-github.js",
    "sanity": "node scripts/sanity-check.js",
    "sync:pull": "node scripts/sync-pull.js",
    "watch": "node scripts/watch-github.js",
    "normalize": "node scripts/normalize-ticket.js",
    "complete": "node scripts/complete-ticket.js",
    "hotfix": "node scripts/hotfix.js"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.5"
  }
}
